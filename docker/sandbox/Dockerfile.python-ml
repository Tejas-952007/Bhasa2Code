# Secure Python ML sandbox image for Bhasha2Code
FROM python:3.12-slim

# Pre-install pinned scientific and machine learning dependencies at build time
RUN pip install --no-cache-dir \
    numpy==2.1.2 \
    scipy==1.14.1 \
    scikit-learn==1.5.2 \
    pandas==2.2.3

# Security: Create unprivileged non-root user
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/sh sandbox && \
    mkdir -p /workspace && \
    chown -R sandbox:sandbox /workspace

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER sandbox

CMD ["python3", "--version"]
