# ==============================================================================
# Bhasha2Code Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
# All settings default to safe, local offline parameters.
# ==============================================================================

# Application & API Gateway Settings
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/bhasha2code.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_USER_ID=default-user
DEFAULT_USER_NAME=Local User

# Local Ollama Inference Settings
# Make sure Ollama daemon is running locally: `ollama serve`
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Active model: qwen2.5-coder:1.5b (recommended for CPU) or qwen2.5-coder:3b
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
# Token cap to prevent runaway loops (default 600, set to 0 to disable cap)
OLLAMA_NUM_PREDICT=600
OLLAMA_DEBUG_LOGGING=false

# Docker Sandbox Security & Execution Limits
BHASHA2CODE_DOCKER_BIN=docker
BHASHA2CODE_SANDBOX_TIMEOUT=3.0
BHASHA2CODE_SANDBOX_MEMORY_MB=256
BHASHA2CODE_SANDBOX_ML_TIMEOUT=10.0
BHASHA2CODE_SANDBOX_ML_MEMORY_MB=768
BHASHA2CODE_SANDBOX_CPU=0.5
BHASHA2CODE_SANDBOX_PIDS=64
BHASHA2CODE_SANDBOX_OUTPUT_LIMIT=65536
BHASHA2CODE_SANDBOX_WORKSPACE_MB=64
